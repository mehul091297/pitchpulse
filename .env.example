# Copy this file to .env and fill in real values. Never commit the real .env.

# Pick one, depending on which LLM you use for the agent pipeline (Phase 3):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: override the model src/agents/crew.py picks by default for
# whichever key above is set (any litellm-style "provider/model" string).
PITCHPULSE_LLM_MODEL=

# Path to the SQLite database (created by src/ingest.py)
PITCHPULSE_DB_PATH=data/processed/pitchpulse.db
